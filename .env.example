# Copy to .env.local (npm run dev) or .env (docker compose). Never commit the real file.

# Groq free tier key: https://console.groq.com/keys
GROQ_API_KEY=

# Picked from GET https://api.groq.com/openai/v1/models (both support JSON output).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Signs the session token that binds a chat to one report. Any long random string.
SESSION_SECRET=

# 1 = strict name mode: only exact names and glossary aliases are accepted
# ("pH Level" is then NOT read as "Urine pH"). Default 0.
LABSAATHI_STRICT_NAMES=0
